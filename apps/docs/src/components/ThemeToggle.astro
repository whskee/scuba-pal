<starlight-theme-toggle>
    <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle color theme"
    >
        <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
            <path
                fill="currentColor"
                d="M21 14.7A8.5 8.5 0 0 1 9.3 3a7 7 0 1 0 11.7 11.7Z"></path>
        </svg>

        <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
            <path
                fill="currentColor"
                d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0 4a1 1 0 0 1-1-1v-1.2a1 1 0 1 1 2 0V21a1 1 0 0 1-1 1Zm0-17.8a1 1 0 0 1-1-1V2a1 1 0 1 1 2 0v1.2a1 1 0 0 1-1 1ZM4.22 20.78a1 1 0 0 1 0-1.41l.85-.85a1 1 0 1 1 1.41 1.41l-.85.85a1 1 0 0 1-1.41 0Zm13.3-13.3a1 1 0 0 1 0-1.41l.85-.85a1 1 0 1 1 1.41 1.41l-.85.85a1 1 0 0 1-1.41 0ZM2 13a1 1 0 1 1 0-2h1.2a1 1 0 1 1 0 2H2Zm18.8 0a1 1 0 1 1 0-2H22a1 1 0 1 1 0 2h-1.2ZM5.07 7.48l-.85-.85a1 1 0 1 1 1.41-1.41l.85.85a1 1 0 0 1-1.41 1.41Zm13.3 13.3-.85-.85a1 1 0 1 1 1.41-1.41l.85.85a1 1 0 0 1-1.41 1.41Z"
            ></path>
        </svg>
    </button>
</starlight-theme-toggle>

<script>
    type Theme = "light" | "dark";

    const storageKey = "starlight-theme";

    function systemTheme(): Theme {
        return matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
    }

    function currentTheme(): Theme {
        const theme = document.documentElement.dataset.theme;
        return theme === "light" || theme === "dark" ? theme : systemTheme();
    }

    function applyTheme(theme: Theme): void {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem(storageKey, theme);

        /**
         * Keeps compatibility with Starlight internals.
         */
        (window as any).StarlightThemeProvider?.updatePickers?.(theme);
    }

    class StarlightThemeToggle extends HTMLElement {
        private button: HTMLButtonElement | null = null;

        connectedCallback() {
            this.button = this.querySelector("button");
            this.sync();

            this.button?.addEventListener("click", () => {
                const nextTheme = currentTheme() === "dark" ? "light" : "dark";
                applyTheme(nextTheme);
                this.sync();
            });
        }

        private sync() {
            const theme = currentTheme();
            const nextTheme = theme === "dark" ? "light" : "dark";

            this.dataset.theme = theme;
            this.button?.setAttribute(
                "aria-label",
                `Switch to ${nextTheme} mode`,
            );
            this.button?.setAttribute("title", `Switch to ${nextTheme} mode`);
        }
    }

    if (!customElements.get("starlight-theme-toggle")) {
        customElements.define("starlight-theme-toggle", StarlightThemeToggle);
    }
</script>

<style>
    .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        background: var(--sl-color-bg-nav);
        color: var(--sl-color-text);
        cursor: pointer;
    }

    .theme-toggle:hover {
        background: var(--sl-color-gray-6);
    }

    .icon {
        width: 1.25rem;
        height: 1.25rem;
    }

    .sun {
        display: none;
    }

    :root[data-theme="light"] .sun {
        display: block;
    }

    :root[data-theme="light"] .moon {
        display: none;
    }

    :root[data-theme="dark"] .moon {
        display: block;
    }

    :root[data-theme="dark"] .sun {
        display: none;
    }
</style>
