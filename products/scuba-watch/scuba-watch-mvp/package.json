{
  "name": "scuba-watch-mvp",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace apps/mobile run start",
    "android": "npm --workspace apps/mobile run android",
    "ios": "npm --workspace apps/mobile run ios",
    "web": "npm --workspace apps/mobile run web",
    "test": "npm --workspace packages/dive-core run test",
    "test:core": "npm --workspace packages/dive-core run test",
    "typecheck": "npm --workspace packages/dive-core run typecheck && npm --workspace apps/mobile run typecheck"
  },
  "devDependencies": {
    "typescript": "~5.3.3"
  }
}
