# ------------ APPLICATION ------------
# Server port configuration (optional, defaults to 8080)
APP_PORT=8080

AWS_ACCESS_KEY_ID=example_access_key_id
AWS_SECRET_ACCESS_KEY=example_secret_access_key

# ------------------------ DATABASE ------------------------
# For docker-compose (creates and configures the Postgres container)
POSTGRES_DB=<project_name>
POSTGRES_USER=<project_name>_admin
POSTGRES_PASSWORD=change_me

# For application configuration (used by Spring Boot to connect to the database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}



# ------------------------ MEDIA ------------------------
# AWS S3
# Optional: Base URL for media files (e.g. S3 bucket URL or CDN URL). If not set, the app will generate presigned URLs for uploads and downloads.
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_BUCKET=change_me
MEDIA_S3_REGION=us-west-2



# ------------------------ MAILING ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
