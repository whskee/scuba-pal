# ------------ APPLICATION CONFIGURATION ------------
# Server port configuration (optional, defaults to 8080)
APP_PORT=8080


# ------------------------ DATABASE CONFIGURATION ------------------------
# For docker-compose (creates and configures the Postgres container)
SCUBA_PAL_POSTGRES_DB=change_me
SCUBA_PAL_POSTGRES_USER=change_me
SCUBA_PAL_POSTGRES_PASSWORD=change_me

# For application configuration (used by Spring Boot to connect to the database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=${SCUBA_PAL_POSTGRES_DB}
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_USERNAME=${SCUBA_PAL_POSTGRES_USER}
DB_PASSWORD=${SCUBA_PAL_POSTGRES_PASSWORD}


# ------------------------ AWS S3 CONFIGURATION ------------------------
MEDIA_S3_BUCKET=change_me
MEDIA_S3_REGION=us-west-2