TableGroup "identity" {
  "identity"."flyway_schema_history"
  "identity"."roles"
  "identity"."users"
  "identity"."profiles"
  "identity"."password_reset_tokens"
}

TableGroup "certification" {
  "certification"."certification_levels"
  "certification"."user_certifications"
}

TableGroup "dive" {
  "dive"."dive_locations"
  "dive"."dive_shops"
}

TableGroup "social" {
  "social"."user_follows"
  "social"."posts"
  "social"."post_media"
  "social"."post_likes"
  "social"."post_comments"
}

TableGroup "messaging" {
  "messaging"."conversations"
  "messaging"."messages"
}

DiagramView identity_view {
  TableGroups {
    certification
  }

  Schemas {
    identity
  }
}

Table "certification"."certification_agencies" {
  "certification_agency_id" int8 [pk, not null, increment]
  "agency_name" varchar(120) [unique, not null]
  "agency_code" varchar(30) [unique, not null]
  "website_url" varchar(255)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "certification"."certification_levels" {
  "certification_level_id" int8 [pk, not null, increment]
  "certification_agency_id" int8 [not null]
  "certification_name" varchar(120) [not null]
  "certification_code" varchar(50)
  "description" varchar(500)
  "display_order" int4 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "certification"."user_certifications" {
  "user_certification_id" int8 [pk, not null, increment]
  "user_id" int8 [not null]
  "certification_level_id" int8 [not null]
  "certification_number" varchar(100)
  "issued_on" date
  "expires_on" date
  "verified_at" timestamp
  "verification_status" varchar(20) [not null, default: 'PENDING']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "dive"."dive_locations" {
  "dive_location_id" int8 [pk, not null, increment]
  "location_name" varchar(180) [not null]
  "description" varchar(600)
  "city" varchar(120)
  "state" varchar(120)
  "country" varchar(120)
  "latitude" numeric(10,7)
  "longitude" numeric(10,7)
  "difficulty_level" varchar(30)
  "popularity_score" int4 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    city [type: btree, name: "idx_dive_locations_city"]
  }
}

Table "dive"."dive_shops" {
  "dive_shop_id" int8 [pk, not null, increment]
  "dive_location_id" int8
  "shop_name" varchar(180) [not null]
  "description" varchar(600)
  "phone_number" varchar(40)
  "email" varchar(255)
  "website_url" varchar(255)
  "street_address" varchar(255)
  "city" varchar(120)
  "state" varchar(120)
  "country" varchar(120)
  "latitude" numeric(10,7)
  "longitude" numeric(10,7)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "identity"."flyway_schema_history" {
  "installed_rank" int4 [pk, not null]
  "version" varchar(50)
  "description" varchar(200) [not null]
  "type" varchar(20) [not null]
  "script" varchar(1000) [not null]
  "checksum" int4
  "installed_by" varchar(100) [not null]
  "installed_on" timestamp [not null, default: `now()`]
  "execution_time" int4 [not null]
  "success" bool [not null]

  Indexes {
    success [type: btree, name: "flyway_schema_history_s_idx"]
  }
}

Table "identity"."roles" {
  "role_id" int8 [pk, not null, increment]
  "role_name" varchar(50) [unique, not null]
  "role_description" varchar(255)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "identity"."users" {
  "user_id" int8 [pk, not null, increment]
  "email" varchar(255) [unique, not null]
  "username" varchar(60) [unique, not null]
  "password_hash" varchar(255) [not null]
  "role_id" int8 [not null]
  "is_active" bool [not null, default: true]
  "email_verified_at" timestamp
  "last_login_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "deleted_at" timestamp
}

Table "identity"."profiles" {
  "profile_id" int8 [pk, not null, increment]
  "user_id" int8 [unique, not null]
  "profile_image_url" varchar(500)
  "first_name" varchar(80)
  "last_name" varchar(80)
  "phone_number" varchar(40)
  "city" varchar(120)
  "state" varchar(120)
  "country" varchar(120)
  "date_of_birth" date
  "visibility_status" varchar(20) [not null, default: 'PUBLIC']
  "dive_count" int4 [not null, default: 0]
  "bio" varchar(400)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    city [type: btree, name: "idx_profiles_city"]
  }
}

Table "identity"."password_reset_tokens" {
  "password_reset_token_id" int8 [pk, not null, increment]
  "user_id" int8 [not null]
  "token" varchar(120) [unique, not null]
  "expires_at" timestamp [not null]
  "used_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    token [type: btree, name: "idx_password_reset_tokens_token"]
    user_id [type: btree, name: "idx_password_reset_tokens_user_id"]
  }
}

Table "learn"."articles" {
  "learn_article_id" int8 [pk, not null, increment]
  "slug" varchar(140) [unique, not null]
  "title" varchar(180) [not null]
  "summary" varchar(600) [not null]
  "content" text [not null]
  "category" varchar(80) [not null]
  "difficulty_level" varchar(40) [not null]
  "estimated_minutes" int4 [not null, default: 5]
  "display_order" int4 [not null, default: 0]
  "is_published" bool [not null, default: true]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (is_published, display_order, title) [type: btree, name: "idx_learn_articles_published_order"]
  }
}

Table "messaging"."conversations" {
  "conversation_id" int8 [pk, not null, increment]
  "user_one_id" int8 [not null]
  "user_two_id" int8 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `user_one_id <> user_two_id` [name: 'conversations_not_self']
  }

  Indexes {
    (user_one_id, user_two_id) [type: btree, unique, name: "conversations_unique_pair"]
    user_one_id [type: btree, name: "idx_conversations_user_one"]
    user_two_id [type: btree, name: "idx_conversations_user_two"]
  }
}

Table "messaging"."messages" {
  "message_id" int8 [pk, not null, increment]
  "conversation_id" int8 [not null]
  "sender_user_id" int8 [not null]
  "message_text" varchar(1000) [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "read_at" timestamp

  Indexes {
    conversation_id [type: btree, name: "idx_messages_conversation"]
    (conversation_id, sender_user_id, read_at) [type: btree, name: "idx_messages_unread"]
  }
}

Table "notification"."notifications" {
  "notification_id" int8 [pk, not null, increment]
  "user_id" int8 [not null]
  "title" varchar(180) [not null]
  "message" varchar(500) [not null]
  "is_read" bool [not null, default: false]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (user_id, is_read) [type: btree, name: "idx_notifications_user_read"]
  }
}

Table "social"."user_follows" {
  "user_follow_id" int8 [pk, not null, increment]
  "follower_user_id" int8 [not null]
  "followed_user_id" int8 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Checks {
    `follower_user_id <> followed_user_id` [name: 'user_follows_not_self']
  }

  Indexes {
    (follower_user_id, followed_user_id) [type: btree, unique, name: "user_follows_unique_pair"]
  }
}

Table "social"."posts" {
  "post_id" int8 [pk, not null, increment]
  "user_id" int8 [not null]
  "caption" varchar(500)
  "post_type" varchar(20) [not null, default: 'TEXT']
  "visibility_status" varchar(20) [not null, default: 'PUBLIC']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "deleted_at" timestamp

  Indexes {
    user_id [type: btree, name: "idx_posts_user_id"]
  }
}

Table "social"."post_media" {
  "post_media_id" int8 [pk, not null, increment]
  "post_id" int8 [not null]
  "media_url" varchar(500) [not null]
  "media_type" varchar(20) [not null]
  "display_order" int4 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    post_id [type: btree, name: "idx_post_media_post_id"]
  }
}

Table "social"."post_likes" {
  "post_like_id" int8 [pk, not null, increment]
  "post_id" int8 [not null]
  "user_id" int8 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (post_id, user_id) [type: btree, unique, name: "post_likes_unique_pair"]
    post_id [type: btree, name: "idx_post_likes_post_id"]
  }
}

Table "social"."post_comments" {
  "post_comment_id" int8 [pk, not null, increment]
  "post_id" int8 [not null]
  "user_id" int8 [not null]
  "comment_text" varchar(500) [not null]
  "parent_comment_id" int8
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "deleted_at" timestamp

  Indexes {
    post_id [type: btree, name: "idx_post_comments_post_id"]
  }
}

Ref "certification_levels_certification_agency_id_fkey":"certification"."certification_agencies"."certification_agency_id" < "certification"."certification_levels"."certification_agency_id"

Ref "user_certifications_certification_level_id_fkey":"certification"."certification_levels"."certification_level_id" < "certification"."user_certifications"."certification_level_id"

Ref "user_certifications_user_id_fkey":"identity"."users"."user_id" < "certification"."user_certifications"."user_id"

Ref "dive_shops_dive_location_id_fkey":"dive"."dive_locations"."dive_location_id" < "dive"."dive_shops"."dive_location_id"

Ref "password_reset_tokens_user_id_fkey":"identity"."users"."user_id" < "identity"."password_reset_tokens"."user_id"

Ref "profiles_user_id_fkey":"identity"."users"."user_id" < "identity"."profiles"."user_id"

Ref "users_role_id_fkey":"identity"."roles"."role_id" < "identity"."users"."role_id"

Ref "conversations_user_one_id_fkey":"identity"."users"."user_id" < "messaging"."conversations"."user_one_id"

Ref "conversations_user_two_id_fkey":"identity"."users"."user_id" < "messaging"."conversations"."user_two_id"

Ref "messages_conversation_id_fkey":"messaging"."conversations"."conversation_id" < "messaging"."messages"."conversation_id"

Ref "messages_sender_user_id_fkey":"identity"."users"."user_id" < "messaging"."messages"."sender_user_id"

Ref "notifications_user_id_fkey":"identity"."users"."user_id" < "notification"."notifications"."user_id"

Ref "post_comments_parent_comment_id_fkey":"social"."post_comments"."post_comment_id" < "social"."post_comments"."parent_comment_id"

Ref "post_comments_post_id_fkey":"social"."posts"."post_id" < "social"."post_comments"."post_id"

Ref "post_comments_user_id_fkey":"identity"."users"."user_id" < "social"."post_comments"."user_id"

Ref "post_likes_post_id_fkey":"social"."posts"."post_id" < "social"."post_likes"."post_id"

Ref "post_likes_user_id_fkey":"identity"."users"."user_id" < "social"."post_likes"."user_id"

Ref "post_media_post_id_fkey":"social"."posts"."post_id" < "social"."post_media"."post_id"

Ref "posts_user_id_fkey":"identity"."users"."user_id" < "social"."posts"."user_id"

Ref "user_follows_followed_user_id_fkey":"identity"."users"."user_id" < "social"."user_follows"."followed_user_id"

Ref "user_follows_follower_user_id_fkey":"identity"."users"."user_id" < "social"."user_follows"."follower_user_id"
