# ------------ APPLICATION ------------
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
JWT_ISSUER=scubapal-app
# Use a unique 32+ byte secret in every non-dev/test environment.
JWT_SECRET=change_me_to_a_unique_32_byte_minimum_secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Auth-sensitive endpoint rate limits.
AUTH_RATE_LIMIT_LOGIN_CAPACITY=5
AUTH_RATE_LIMIT_LOGIN_WINDOW=1m
AUTH_RATE_LIMIT_REGISTER_CAPACITY=5
AUTH_RATE_LIMIT_REGISTER_WINDOW=1h
AUTH_RATE_LIMIT_USERNAME_AVAILABILITY_CAPACITY=20
AUTH_RATE_LIMIT_USERNAME_AVAILABILITY_WINDOW=1m
AUTH_RATE_LIMIT_FORGOT_PASSWORD_CAPACITY=3
AUTH_RATE_LIMIT_FORGOT_PASSWORD_WINDOW=15m
AUTH_RATE_LIMIT_RESET_PASSWORD_CAPACITY=5
AUTH_RATE_LIMIT_RESET_PASSWORD_WINDOW=15m
AUTH_RATE_LIMIT_REFRESH_CAPACITY=20
AUTH_RATE_LIMIT_REFRESH_WINDOW=1m

AWS_ACCESS_KEY_ID=example_access_key_id
AWS_SECRET_ACCESS_KEY=example_secret_access_key

# ------------------------ DATABASE ------------------------
# Used by the root compose.yaml Postgres service.
POSTGRES_PORT=5432
POSTGRES_USER=scubapal_runtime
POSTGRES_PASSWORD=scubapal

# Used by Spring Boot when running locally on your Mac.
POSTGRES_DB=scubapal
DB_USER=scubapal_runtime
DB_PASSWORD=scubapal
DB_URL=jdbc:postgresql://localhost:5432/scubapal

# ------------------------ MEDIA ------------------------
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_BUCKET=change_me
MEDIA_S3_REGION=us-west-2
MEDIA_UPLOAD_URL_EXPIRES_MINUTES=10
MEDIA_MAX_PROFILE_IMAGE_BYTES=5242880
MEDIA_MAX_POST_IMAGE_BYTES=10485760

# ------------------------ MAILING ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_ENABLED=true
APP_MAIL_FROM="Scuba Pal <no-reply@scubapal.local>"
