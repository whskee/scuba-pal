  -presigner: S3Presigner
  -s3Client: S3Client
  --
  +MediaStorageService(properties: MediaStorageProperties)
  +createUpload(user: User, request: CreateMediaUploadRequest): MediaUploadResponse
  -uploadHeaders(contentType: String, metadata: Map<String,String>): Map<String,String>
  +close(): void
  +publicUrlForKey(objectKey: String): String
  +read(objectKey: String): StoredMedia
  +normalizeManagedUrl(value: String): String
  -buildObjectKey(user: User, purpose: MediaUploadPurpose, fileName: String, contentType: String): String
  -extractObjectKey(value: String): String
  -bucketName(): String
  -extractBucketFromUrl(bucketUrl: String): String
  -normalizeContentType(contentType: String): String
  -maxBytes(purpose: MediaUploadPurpose): long
  -extension(fileName: String, contentType: String): String
  -trimLeadingSlash(value: String): String
}

class MediaController {
  -userRepository: UserRepository
  -mediaStorageService: MediaStorageService
  --
  +MediaController(userRepository: UserRepository, mediaStorageService: MediaStorageService)
  +createUpload(request: CreateMediaUploadRequest, authentication: Authentication): ResponseEntity<MediaUploadResponse>
}

class PublicMediaController {
  -mediaStorageService: MediaStorageService
  --
  +PublicMediaController(mediaStorageService: MediaStorageService)
  +getMedia(request: HttpServletRequest): ResponseEntity<byte[]>
}

